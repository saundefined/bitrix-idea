<idea-plugin>
    <id>ru.panteleev.bitrix-idea</id>
    <name>Bitrix Idea</name>
    <vendor email="sergey@php.net" url="https://github.com/saundefined/bitrix-idea/">sergey-panteleev</vendor>

    <description><![CDATA[
        <p>Plugin for <a href="https://www.jetbrains.com/phpstorm">PhpStorm</a> to help the developer navigate the Bitrix CMS core source code.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- PHP insight is optional so the plugin also installs in PhpStorm Lite / IDE without PHP. -->
    <depends optional="true" config-file="bitrix-php.xml">com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <additionalLibraryRootsProvider
                implementation="com.github.saundefined.bitrix_idea.library.BitrixLibraryRootsProvider"/>
        <fileTemplateGroup
                implementation="com.github.saundefined.bitrix_idea.templates.module.BitrixModuleFileTemplateGroupFactory"/>
        <fileTemplateGroup
                implementation="com.github.saundefined.bitrix_idea.templates.simple_component.BitrixSimpleComponentFileTemplateGroupFactory"/>
        <fileTemplateGroup
                implementation="com.github.saundefined.bitrix_idea.templates.template.BitrixTemplateFileTemplateGroupFactory"/>
        <fileTemplateGroup
                implementation="com.github.saundefined.bitrix_idea.templates.gitignore.BitrixModuleFileTemplateGroupFactory"/>
        <projectViewNodeDecorator
                implementation="com.github.saundefined.bitrix_idea.toolwindow.BitrixProjectViewNodeDecorator"/>
        <gotoSymbolContributor
                implementation="com.github.saundefined.bitrix_idea.php.BitrixChooseByNameContributor"/>
        <toolWindow
                id="Bitrix"
                anchor="right"
                icon="/icons/bitrix.svg"
                factoryClass="com.github.saundefined.bitrix_idea.toolwindow.BitrixToolWindowFactory"/>
        <notificationGroup id="Bitrix Idea Plugin" displayType="BALLOON"/>
        <notificationGroup id="Bitrix Idea Framework" displayType="BALLOON"/>
        <postStartupActivity implementation="com.github.saundefined.bitrix_idea.activity.NotificationStartupActivity"/>
        <postStartupActivity implementation="com.github.saundefined.bitrix_idea.activity.BitrixProjectDetectionActivity"/>
        <postStartupActivity implementation="com.github.saundefined.bitrix_idea.roots.BitrixSourceRootsStartupActivity"/>
        <postStartupActivity implementation="com.github.saundefined.bitrix_idea.toolwindow.BitrixToolWindowStartupActivity"/>
        <projectConfigurable
                parentId="settings.php.frameworks"
                instance="com.github.saundefined.bitrix_idea.settings.BitrixProjectConfigurable"
                id="com.github.saundefined.bitrix_idea.settings.BitrixProjectConfigurable"
                displayName="Bitrix"/>
        <applicationService serviceImplementation="com.github.saundefined.bitrix_idea.settings.AppSettingsState"/>
        <projectService serviceImplementation="com.github.saundefined.bitrix_idea.settings.BitrixProjectSettings"/>
    </extensions>

    <actions>
        <group
                id="com.github.saundefined.bitrix_idea.actions.BitrixIdeaMenu"
                text="Bitrix Idea"
                popup="true"
                icon="icons.BitrixIdeaIcons.Bitrix"
        >
            <add-to-group group-id="NewGroup" anchor="first"/>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateGitignoreAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateGitignoreAction"
                    text=".gitignore"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateD7ClassAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateD7ClassAction"
                    text="D7-класс"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateOrmEntityAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateOrmEntityAction"
                    text="ORM-сущность"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateComplexComponentAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateComplexComponentAction"
                    text="Комплексный компонент"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateComponentTemplateAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateComponentTemplateAction"
                    text="Шаблон компонента"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateComponentOverrideAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateComponentOverrideAction"
                    text="Переопределить шаблон компонента"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateComponentParametersAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateComponentParametersAction"
                    text="Параметры компонента"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateEventHandlerAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateEventHandlerAction"
                    text="Обработчик события"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateAgentAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateAgentAction"
                    text="Агент"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateServiceAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateServiceAction"
                    text="Сервис с интерфейсом"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateComponentClassAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateComponentClassAction"
                    text="Класс компонента"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateOptionsPageAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateOptionsPageAction"
                    text="Страница настроек модуля"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateAdminPageAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateAdminPageAction"
                    text="Admin-страница"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateRestControllerAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateRestControllerAction"
                    text="REST-контроллер"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateConsoleCommandAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateConsoleCommandAction"
                    text="Консольная команда"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateSimpleComponentAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateSimpleComponentAction"
                    text="Простой компонент"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateTemplateAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateTemplateAction"
                    text="Шаблон"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.CreateModuleAction"
                    id="com.github.saundefined.bitrix_idea.actions.CreateModuleAction"
                    text="Модуль"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
            </action>
            <separator/>
            <action
                    class="com.github.saundefined.bitrix_idea.actions.AddAjaxActionAction"
                    id="com.github.saundefined.bitrix_idea.actions.AddAjaxActionAction"
                    text="Добавить AJAX-действие"
                    icon="icons.BitrixIdeaIcons.Bitrix"
            >
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
        </group>

        <group
                id="com.github.saundefined.bitrix_idea.actions.BitrixIdeaProjectViewGroup"
                text="Bitrix Idea"
                popup="true"
                icon="icons.BitrixIdeaIcons.Bitrix"
        >
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateSimpleComponentAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateTemplateAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateComponentParametersAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateComponentClassAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateComponentOverrideAction"/>
            <separator/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateOptionsPageAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateAdminPageAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateRestControllerAction"/>
            <reference ref="com.github.saundefined.bitrix_idea.actions.CreateConsoleCommandAction"/>
        </group>
    </actions>

    <resource-bundle>messages.BitrixIdeaBundle</resource-bundle>
</idea-plugin>